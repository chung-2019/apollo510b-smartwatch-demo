# ---------------------------------------------------------------------------
# Downloaded raw map data (about 972 MB)
#
# The input of tools/map_tile_gen.py and render_taipei_osm_tiles.py, not their
# output. Three of the files exceed GitHub's hard 100 MB per-file limit and
# could never be pushed anyway.
#
# To regenerate the tiles, download taiwan-latest-free.shp.zip from Geofabrik
# again and extract it here; the steps are in docs/map_navigation/.
# ---------------------------------------------------------------------------
tmp/osm_taipei/

# ---------------------------------------------------------------------------
# Build output
#
# The output directory of each of the three toolchains (gcc 28 MB, iar 3.9 MB,
# keil6 1.6 MB). All of it is regenerated by make, and the .o / .axf / .map
# files change on every rebuild, so version control would only make every
# commit tens of MB of noise.
# ---------------------------------------------------------------------------
gcc/bin/
iar/bin/
keil6/bin/
keil6/Listings/
iar/Debug/
iar/settings/

# ---------------------------------------------------------------------------
# Manual backup files
#
# Redundant once there is git. The files stay on disk, they just do not enter
# the repository.
# ---------------------------------------------------------------------------
*.bak

# ---------------------------------------------------------------------------
# Local settings of build_gui.py
#
# Written automatically the first time the GUI runs, and it holds absolute
# paths from that machine (the project directory, MSYS2, the Arm toolchain, the
# installed J-Link version). Useless to anyone else and actively misleading, so
# it stays out of the repository. Delete it to have the GUI re-detect
# everything.
# ---------------------------------------------------------------------------
.build_gui.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/
Thumbs.db
desktop.ini
